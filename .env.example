MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
ALLOW_META_API_CALLS=false
MAX_UPLOAD_MB=5
MAX_DATA_ROWS=5000
MAX_COLUMNS=100
IMPORTGUARD_DB=data/importguard.db
SESSION_DAYS=30
EXPORT_RETENTION_DAYS=7
MAX_STORED_PACKAGE_MB=8
BILLING_ENFORCE_QUOTAS=false
ADMIN_EMAILS=
AUTH_FAILURE_LIMIT_PER_IP=10
AUTH_FAILURE_LIMIT_PER_ACCOUNT=10
AUTH_RATE_WINDOW_SECONDS=300
API_PROFILE_LIMIT_PER_WINDOW=120
API_SUGGEST_LIMIT_PER_WINDOW=60
API_PROCESS_LIMIT_PER_WINDOW=30
API_REPLAY_LIMIT_PER_WINDOW=30
MAX_CONCURRENT_PROCESSING=2
OAUTH_STATE_TTL_SECONDS=600
# OAuth is disabled until each provider has all three values configured.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/oauth/github/callback
